{
  "name": "myblog",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"wrangler dev\" \"vite --host 127.0.0.1\"",
    "typecheck": "tsc --noEmit -p tsconfig.worker.json && tsc --noEmit",
    "build:client": "vite build",
    "build": "npm run typecheck && vite build",
    "check:deploy": "wrangler deploy --dry-run --outdir=dist",
    "deploy": "npm run build && wrangler deploy",
    "seed": "node scripts/seed.mjs",
    "format": "prettier --write server client/src shared"
  },
  "dependencies": {
    "better-auth": "^1.7.4",
    "hono": "^4.9.0",
    "kysely": "^0.29.5",
    "kysely-d1": "^0.4.0",
    "lucide-react": "^1.45.0",
    "music-metadata": "^11.15.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260915.1",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "prettier": "^3.9.6",
    "typescript": "^5.8.0",
    "vite": "^8.3.0",
    "wrangler": "^4.20.0"
  },
  "description": "momo-blog 的 Cloudflare（Workers + D1 + R2）移植版：个人 Bento 空间。",
  "license": "MIT"
}